<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.campus.lostfound.model.Item,com.campus.lostfound.util.WebUtil" %><%@ include file="partials.jspf" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Saved items · CampusFind</title><link rel="stylesheet" href="<%=ctx%>/css/style.css"></head><body><%@ include file="nav.jspf" %><main class="container page"><p class="eyebrow">YOUR SHORTLIST</p><h1>Saved items</h1><p class="muted">Listings you've bookmarked for later.</p><div class="grid"><%List<Item> items=(List<Item>)request.getAttribute("savedItems");for(Item i:items){%><article class="item-card"><span class="type-pill <%= "FOUND".equals(i.getType())?"found":"lost" %>"><%=WebUtil.h(i.getType())%></span><%if(!i.getPhotoName().isBlank()){%><img class="item-photo" src="<%=ctx%>/photo/<%=WebUtil.h(i.getPhotoName())%>" alt="Item photo"><%}%><h3><%=WebUtil.h(i.getTitle())%></h3><p class="muted"><%=WebUtil.h(i.getLocation())%> · <%=WebUtil.h(i.getDate())%></p><a class="btn btn-light" href="<%=ctx%>/item?id=<%=java.net.URLEncoder.encode(i.getId(),java.nio.charset.StandardCharsets.UTF_8)%>">View details</a></article><%}if(items.isEmpty()){%><div class="empty"><h3>No saved items yet</h3><p>Open a listing and choose Save item to bookmark it.</p><a class="btn" href="<%=ctx%>/items">Browse listings</a></div><%}%></div></main></body></html>
