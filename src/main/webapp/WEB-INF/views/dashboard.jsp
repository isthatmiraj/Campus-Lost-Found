<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*,com.campus.lostfound.model.*,com.campus.lostfound.util.WebUtil" %><%@ include file="partials.jspf" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My dashboard · CampusFind</title><link rel="stylesheet" href="<%=ctx%>/css/style.css"></head><body><%@ include file="nav.jspf" %><main class="container page"><p class="eyebrow">YOUR CAMPUS ACTIVITY</p><h1>My dashboard</h1><p class="muted">Your reports, claim updates, notifications, and return confirmations in one place.</p>
<% if(request.getParameter("handover")!=null){%><div class="success">Your confirmation was recorded. The item is marked returned when both parties confirm.</div><%}if(session.getAttribute("flashError")!=null){%><div class="alert"><%=WebUtil.h((String)session.getAttribute("flashError"))%></div><%session.removeAttribute("flashError");}%>
<% List<Item> myItems=(List<Item>)request.getAttribute("myItems");List<Claim> myClaims=(List<Claim>)request.getAttribute("myClaims");List<String[]> notifications=(List<String[]>)request.getAttribute("notifications");List<String[]> handovers=(List<String[]>)request.getAttribute("handovers"); %>
<div class="admin-stats"><div class="admin-stat"><span>My reports</span><strong><%=myItems.size()%></strong></div><div class="admin-stat"><span>My claims</span><strong><%=myClaims.size()%></strong></div><div class="admin-stat"><span>Unread notifications</span><strong><%=request.getAttribute("unread")%></strong></div></div>
<h2>Notifications</h2><div class="table-wrap"><table><thead><tr><th>Message</th><th>Date</th><th>Status</th><th>Action</th></tr></thead><tbody><%for(String[] n:notifications){%><tr><td><%=WebUtil.h(n[2])%></td><td><%=WebUtil.h(n[4])%></td><td><span class="status"><%=WebUtil.h(n[5])%></span></td><td><%if("UNREAD".equals(n[5])){%><form method="post" action="<%=ctx%>/dashboard"><input type="hidden" name="action" value="read"><input type="hidden" name="notificationId" value="<%=WebUtil.h(n[0])%>"><button class="btn btn-small" type="submit">Mark read</button></form><%}else{%>—<%}%></td></tr><%}if(notifications.isEmpty()){%><tr><td colspan="4">No notifications yet.</td></tr><%}%></tbody></table></div>
<h2>My reports</h2><div class="table-wrap"><table><thead><tr><th>Item</th><th>Type</th><th>Status</th><th>Location / date</th></tr></thead><tbody><%for(Item i:myItems){%><tr><td><%if(!i.getPhotoName().isBlank()){%><img class="admin-thumb" src="<%=ctx%>/photo/<%=WebUtil.h(i.getPhotoName())%>" alt="Item photo"><br><%}%><%=WebUtil.h(i.getTitle())%></td><td><%=WebUtil.h(i.getType())%></td>
<td>
  <span class="status"><%=WebUtil.h(i.getStatus().replace('_',' '))%></span>
  <% if ("LOST".equals(i.getType()) && "OPEN".equals(i.getStatus())) { %>
    <form method="post" action="<%=ctx%>/dashboard"
          onsubmit="return confirm('Have you found your lost item? Mark this report as recovered?');">
      <input type="hidden" name="action" value="recover">
      <input type="hidden" name="itemId" value="<%=WebUtil.h(i.getId())%>">
      <button class="btn btn-small" type="submit">Mark as Recovered</button>
    </form>
  <% } %>
</td>
<td><%=WebUtil.h(i.getLocation())%><br><small><%=WebUtil.h(i.getDate())%></small></td></tr><%}if(myItems.isEmpty()){%><tr><td colspan="4">You haven't reported any items yet.</td></tr><%}%></tbody></table></div>
<h2>My claims</h2><div class="table-wrap"><table><thead><tr><th>Item ID</th><th>Ownership clue</th><th>Submitted</th><th>Status</th></tr></thead><tbody><%for(Claim c:myClaims){%><tr><td><%=WebUtil.h(c.getItemId())%></td><td><%=WebUtil.h(c.getProof())%></td><td><%=WebUtil.h(c.getCreatedAt())%></td><td><span class="status"><%=WebUtil.h(c.getStatus())%></span></td></tr><%}if(myClaims.isEmpty()){%><tr><td colspan="4">No claims yet.</td></tr><%}%></tbody></table></div>
<h2>Return confirmations</h2><p class="muted">After an admin approves a claim, both the reporter and approved claimant must confirm the handover.</p><div class="table-wrap"><table><thead><tr><th>Item ID</th><th>Your role</th><th>Your confirmation</th><th>Other party</th><th>Action</th></tr></thead><tbody><%for(String[] h:handovers){boolean owner=WebUtil.userId(request).equals(h[1]);%><tr><td><%=WebUtil.h(h[0])%></td><td><%=owner?"Reporter / finder":"Approved claimant"%></td><td><%=WebUtil.h(owner?h[3]:h[4])%></td><td><%=WebUtil.h(owner?h[4]:h[3])%></td><td><%if("PENDING".equals(h[5])&&"NO".equals(owner?h[3]:h[4])){%><form method="post" action="<%=ctx%>/handover" onsubmit="return confirm('Confirm that the item has been handed over / received?');"><input type="hidden" name="itemId" value="<%=WebUtil.h(h[0])%>"><button class="btn btn-small" type="submit">Confirm return</button></form><%}else{%><span class="status"><%=WebUtil.h(h[5])%></span><%}%></td></tr><%}if(handovers.isEmpty()){%><tr><td colspan="5">No approved claims awaiting handover.</td></tr><%}%></tbody></table></div></main></body></html>