
<%@ page import="com.campus.lostfound.util.WebUtil" %>
<%@ page import="com.campus.lostfound.util.LogoPreferenceStore" %>
<% String cfLogo = WebUtil.loggedIn(request) ? LogoPreferenceStore.get(WebUtil.userId(request)) : "auto"; %>
<script>
(function() {
    try {
        var t = localStorage.getItem("campusfind-theme");
        if (t === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
        }
    } catch (e) {}
})();
</script>

<header class="topbar">
    <a class="brand" href="<%=request.getContextPath()%>/items" aria-label="CampusFind home">
        <img class="brand-logo theme-aware-logo" data-logo-preference="<%=cfLogo%>" src="<%=request.getContextPath()%>/images/campusfind-logo-<%="white".equals(cfLogo) ? "white" : "black"%>.png" data-context-path="<%=request.getContextPath()%>" alt="CampusFind CF">
        <span>CampusFind</span>
    </a>

    <button type="button" class="mobile-menu-toggle"
            id="mobile-menu-toggle"
            aria-label="Open navigation menu"
            aria-controls="site-nav"
            aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
    </button>

    <% if (WebUtil.loggedIn(request)) { %>
        <div class="profile-menu" id="profile-menu">
            <button type="button" class="profile-menu-trigger"
                    id="profile-menu-trigger"
                    aria-expanded="false"
                    aria-controls="profile-dropdown">
                <span class="profile-menu-avatar">
                    <%=WebUtil.h(((String)session.getAttribute("name")).substring(0, 1).toUpperCase())%>
                </span>
                <span class="profile-menu-name">
                    <%=WebUtil.h((String)session.getAttribute("name"))%>
                </span>
                <span class="profile-menu-chevron" aria-hidden="true"></span>
            </button>

            <div class="profile-dropdown" id="profile-dropdown">
                <a href="<%=request.getContextPath()%>/profile">My Profile</a>
                <form method="post" action="<%=request.getContextPath()%>/logout"
                      onsubmit="return confirm('Are you sure you want to log out?');">
                    <input type="hidden" name="csrfToken"
                           value="<%=WebUtil.h((String) session.getAttribute("csrfToken"))%>">
                    <button type="submit">Log out</button>
                </form>
            </div>
        </div>
    <% } %>

    <nav class="site-nav" id="site-nav">
        <a href="<%=request.getContextPath()%>/items">Browse</a>

        <% if (WebUtil.loggedIn(request)) { %>
            <a href="<%=request.getContextPath()%>/report-item">Report item</a>
            <a href="<%=request.getContextPath()%>/my-claims">My claims</a>
            <a href="<%=request.getContextPath()%>/saved-items">Saved items</a>

            <a href="<%=request.getContextPath()%>/dashboard">
                Dashboard
                <span class="cf-nav-unread" id="cf-notification-count" hidden></span>
            </a>

            <a href="<%=request.getContextPath()%>/chat/inbox">
                Inbox
                <span class="cf-nav-unread" id="cf-chat-count" hidden></span>
            </a>

            <% if (WebUtil.admin(request)) { %>
                <a href="<%=request.getContextPath()%>/admin">Admin</a>
            <% } %>

        <% } else { %>
            <a class="login-btn" href="<%=request.getContextPath()%>/login">Log in</a>
            <a class="nav-cta signup-btn" href="<%=request.getContextPath()%>/register">Sign up</a>
        <% } %>

        <button type="button" class="theme-toggle" id="theme-toggle"
                aria-label="Switch theme" title="Switch theme">
            <span id="theme-icon" aria-hidden="true"></span>
        </button>
    </nav>
</header>


<script>
(function () {
    var button = document.getElementById("mobile-menu-toggle");
    var menu = document.getElementById("site-nav");

    if (!button || !menu) return;

    function closeMenu() {
        menu.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Open navigation menu");
    }

    button.addEventListener("click", function () {
        var isOpen = menu.classList.toggle("is-open");
        button.setAttribute("aria-expanded", String(isOpen));
        button.setAttribute(
            "aria-label",
            isOpen ? "Close navigation menu" : "Open navigation menu"
        );
    });

    menu.addEventListener("click", function (event) {
        if (event.target.closest("a")) closeMenu();
    });

    document.addEventListener("click", function (event) {
        if (!menu.contains(event.target) && !button.contains(event.target)) {
            closeMenu();
        }
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeMenu();
    });
})();
</script>

<script>
(function () {
    var wrapper = document.getElementById("profile-menu");
    var trigger = document.getElementById("profile-menu-trigger");
    var dropdown = document.getElementById("profile-dropdown");

    if (!wrapper || !trigger || !dropdown) return;

    function closeProfileMenu() {
        wrapper.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
    }

    trigger.addEventListener("click", function () {
        var open = wrapper.classList.toggle("is-open");
        trigger.setAttribute("aria-expanded", String(open));
    });

    document.addEventListener("click", function (event) {
        if (!wrapper.contains(event.target)) closeProfileMenu();
    });

    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") closeProfileMenu();
    });
})();
</script>

<script>
(function () {
    var b = document.getElementById("theme-toggle");
    var icon = document.getElementById("theme-icon");
    if (!b || !icon) return;

    var moon = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>';

    var sun = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>';

    function updateIcon() {
        var dark = document.documentElement.getAttribute("data-theme") === "dark";
        icon.innerHTML = dark ? sun : moon;
        b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        b.setAttribute("title", dark ? "Switch to light mode" : "Switch to dark mode");
    }

    function updateBrandLogos() {
        var dark = document.documentElement.getAttribute("data-theme") === "dark";
        document.querySelectorAll(".theme-aware-logo").forEach(function (img) {
            var preference = img.getAttribute("data-logo-preference") || "auto";
            var variant = preference === "auto" ? (dark ? "white" : "black") : preference;
            img.src = img.getAttribute("data-context-path") + "/images/campusfind-logo-" + variant + ".png";
        });
    }

    updateIcon();
    updateBrandLogos();
    document.addEventListener("DOMContentLoaded", updateBrandLogos);

    b.addEventListener("click", function () {
        var dark = document.documentElement.getAttribute("data-theme") === "dark";

        if (dark) {
            document.documentElement.removeAttribute("data-theme");
            localStorage.setItem("campusfind-theme", "light");
        } else {
            document.documentElement.setAttribute("data-theme", "dark");
            localStorage.setItem("campusfind-theme", "dark");
        }

        updateIcon();
        updateBrandLogos();
    });
})();
</script>


<% if (WebUtil.loggedIn(request)) { %>
<script>
(function () {
    var endpoint = '<%=request.getContextPath()%>/presence/heartbeat';
    var csrfToken = '<%=WebUtil.h((String)session.getAttribute("csrfToken"))%>';
    var lastActivity = Date.now();
    var lastHeartbeat = 0;

    function markActivity() { lastActivity = Date.now(); }
    ["pointerdown", "keydown", "touchstart", "scroll", "mousemove"].forEach(function (eventName) {
        document.addEventListener(eventName, markActivity, { passive: true });
    });

    function heartbeat() {
        // Only send heartbeats while the person has interacted recently.
        // This prevents background polling from extending CampusFind's 30-minute session timeout.
        if (document.visibilityState === "hidden" || Date.now() - lastActivity > 120000) return;
        if (Date.now() - lastHeartbeat < 55000) return;
        lastHeartbeat = Date.now();
        fetch(endpoint, {
            method: "POST",
            credentials: "same-origin",
            cache: "no-store",
            headers: { "X-CSRF-Token": csrfToken }
        }).catch(function () {});
    }

    heartbeat();
    window.setInterval(heartbeat, 60000);
    document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "visible") {
            markActivity();
            heartbeat();
        }
    });
})();
</script>
<% } %>


<% if (WebUtil.loggedIn(request)) { %>
<style>
.cf-nav-unread {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 19px; height: 19px; margin-left: 5px; padding: 0 6px;
    border-radius: 999px; background: #00c995; color: #042016;
    font-size: 10px; font-weight: 900; line-height: 1;
    vertical-align: middle; box-shadow: 0 0 0 3px rgba(0,214,160,.12);
}
.cf-nav-unread[hidden] { display: none; }
</style>
<script>
(function () {
    var endpoint = '<%=request.getContextPath()%>/chat/updates';
    var notificationBadge = document.getElementById('cf-notification-count');
    var chatBadge = document.getElementById('cf-chat-count');
    var busy = false;

    function updateBadge(element, value) {
        if (!element) return;
        var n = Number(value) || 0;
        element.textContent = n > 99 ? '99+' : String(n);
        element.hidden = n < 1;
        element.setAttribute('aria-label', n + ' unread');
    }

    async function refreshUnread() {
        if (busy || document.visibilityState === 'hidden') return;
        busy = true;
        try {
            var response = await fetch(endpoint, {
                credentials: 'same-origin', cache: 'no-store',
                headers: {'Accept':'application/json'}
            });
            if (!response.ok) return;
            var data = await response.json();
            updateBadge(notificationBadge, data.unreadNotifications);
            updateBadge(chatBadge, data.unreadMessages);
        } catch (error) {
            // Retain the last successful counts during temporary network errors.
        } finally {
            busy = false;
        }
    }

    refreshUnread();
    window.setInterval(refreshUnread, 8000);
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') refreshUnread();
    });
})();
</script>
<% } %>


<% if (WebUtil.loggedIn(request)) { %>
<style>
#cf-live-chat-toast-stack {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 10050;
    width: min(390px, calc(100vw - 28px));
    display: flex;
    flex-direction: column;
    gap: 11px;
    pointer-events: none;
}

.cf-live-chat-toast {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) 28px;
    gap: 11px;
    align-items: start;
    padding: 15px;
    border: 1px solid var(--line, rgba(120,140,160,.25));
    border-radius: 17px;
    background: var(--surface, #fff);
    color: var(--text, #17212b);
    box-shadow: 0 15px 45px rgba(0,0,0,.22);
    pointer-events: auto;
    cursor: pointer;
    animation: cf-toast-in .42s cubic-bezier(.2,1.35,.4,1) both;
    backdrop-filter: blur(18px);
}

.cf-live-chat-toast:hover {
    transform: translateY(-3px);
}

.cf-live-chat-avatar {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg,#00d6a0,#00a9c7);
    color: #03251d;
    font-weight: 900;
    font-size: 17px;
}

.cf-live-chat-content {
    min-width: 0;
}

.cf-live-chat-heading {
    display: block;
    font-size: 13px;
    font-weight: 850;
    margin: 1px 0 3px;
}

.cf-live-chat-item {
    display: block;
    color: var(--accent,#00a982);
    font-size: 11px;
    font-weight: 750;
    margin-bottom: 5px;
}

.cf-live-chat-preview {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow-wrap: anywhere;
    color: var(--muted,#667085);
    font-size: 12px;
    line-height: 1.45;
}

.cf-live-chat-close {
    border: 0;
    background: transparent;
    color: var(--muted,#667085);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 0;
}

@keyframes cf-toast-in {
    from {
        opacity: 0;
        transform: translate(28px,18px) scale(.92);
    }
    to {
        opacity: 1;
        transform: translate(0,0) scale(1);
    }
}

@keyframes cf-toast-out {
    to {
        opacity: 0;
        transform: translateX(35px) scale(.96);
    }
}

@media(max-width:600px) {
    #cf-live-chat-toast-stack {
        right: 12px;
        top: max(12px, env(safe-area-inset-top));
        bottom: auto;
        width: calc(100vw - 24px);
    }

    .cf-live-chat-toast {
        animation-name: cf-toast-mobile-in;
    }
}

@keyframes cf-toast-mobile-in {
    from { opacity: 0; transform: translateY(-24px) scale(.94); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

@media(prefers-reduced-motion:reduce) {
    .cf-live-chat-toast {
        animation: none;
    }
}
</style>

<div id="cf-live-chat-toast-stack"
     aria-live="polite"
     aria-label="New chat messages"></div>

<script>
(function () {
    var endpoint = '<%=request.getContextPath()%>/chat/live-messages';
    var currentUser = '<%=WebUtil.h(WebUtil.userId(request))%>';
    var stack = document.getElementById('cf-live-chat-toast-stack');

    if (!stack) return;

    var storageKey = 'cf-live-chat-cursor-' + currentUser;
    var cursor = null;
    var busy = false;
    var seen = new Set();

    try {
        var stored = sessionStorage.getItem(storageKey);

        if (stored && /^\d+$/.test(stored)) {
            cursor = stored;
        }
    } catch (error) {}

    function isCurrentConversation(id) {
        if (!/\/chat\/room\/?$/.test(window.location.pathname)) {
            return false;
        }

        return new URLSearchParams(window.location.search)
            .get('conversationId') === id;
    }

    function dismissToast(toast) {
        if (!toast || !toast.isConnected) return;

        toast.style.animation = 'cf-toast-out .2s ease forwards';

        window.setTimeout(function () {
            toast.remove();
        }, 210);
    }

    function showToast(message) {
        var id = String(message.id);

        if (!message.id || seen.has(id)) return;
        seen.add(id);

        if (isCurrentConversation(message.conversationId)) return;

        while (stack.children.length >= 3) {
            stack.firstElementChild.remove();
        }

        var toast = document.createElement('div');
        toast.className = 'cf-live-chat-toast';
        toast.setAttribute('role', 'status');

        var avatar = document.createElement('div');
        avatar.className = 'cf-live-chat-avatar';
        avatar.textContent = (message.senderName || 'C')
            .trim().charAt(0).toUpperCase();

        var content = document.createElement('div');
        content.className = 'cf-live-chat-content';

        var heading = document.createElement('strong');
        heading.className = 'cf-live-chat-heading';
        heading.textContent = (message.senderName || 'Campus user')
            + ' sent you a message';

        var item = document.createElement('span');
        item.className = 'cf-live-chat-item';
        item.textContent = 'Regarding: '
            + (message.itemTitle || 'Campus listing');

        var preview = document.createElement('span');
        preview.className = 'cf-live-chat-preview';
        preview.textContent = message.text || 'New message';

        content.append(heading, item, preview);

        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'cf-live-chat-close';
        close.setAttribute('aria-label', 'Dismiss message notification');
        close.textContent = '\u00D7';

        close.addEventListener('click', function (event) {
            event.stopPropagation();
            dismissToast(toast);
        });

        toast.append(avatar, content, close);

        toast.addEventListener('click', function () {
            window.location.href =
                '<%=request.getContextPath()%>/chat/room?conversationId='
                + encodeURIComponent(message.conversationId);
        });

        stack.appendChild(toast);

        window.setTimeout(function () {
            dismissToast(toast);
        }, 8500);
    }

    async function poll() {
        if (busy || document.visibilityState === 'hidden') return;

        busy = true;

        try {
            var url = endpoint;

            if (cursor !== null) {
                url += '?after=' + encodeURIComponent(cursor);
            }

            var response = await fetch(url, {
                credentials: 'same-origin',
                cache: 'no-store',
                headers: {'Accept':'application/json'}
            });

            if (!response.ok) return;

            var data = await response.json();

            // First poll establishes the cursor, preventing old-message spam.
            if (cursor === null) {
                cursor = String(data.cursor || 0);

                try {
                    sessionStorage.setItem(storageKey, cursor);
                } catch (error) {}

                return;
            }

            (data.messages || []).forEach(function (message) {
                if (String(message.senderId) !== currentUser) {
                    showToast(message);
                }
            });

            var nextCursor = String(data.cursor || cursor);

            if (/^\d+$/.test(nextCursor)) {
                cursor = nextCursor;

                try {
                    sessionStorage.setItem(storageKey, cursor);
                } catch (error) {}
            }

        } catch (error) {
            // Keep the last cursor and retry on the next poll.
        } finally {
            busy = false;
        }
    }

    poll();
    window.setInterval(poll, 3000);

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible') {
            poll();
        }
    });
})();
</script>
<% } %>


<!-- cf-smart-prefetch-v1 -->
<script>
(function () {
    "use strict";

    if (!("relList" in HTMLLinkElement.prototype) ||
        !HTMLLinkElement.prototype.relList.supports("prefetch")) return;

    var connection = navigator.connection || navigator.mozConnection ||
                     navigator.webkitConnection;

    if (connection && (connection.saveData ||
        /(^|-)2g$/.test(connection.effectiveType || ""))) return;

    var context = '<%=request.getContextPath()%>';
    var prefetched = new Set();
    var pending = new WeakMap();
    var maximum = 6;

    function eligible(anchor) {
        if (!anchor || anchor.tagName !== "A") return null;
        if (anchor.target || anchor.hasAttribute("download")) return null;

        var url;
        try {
            url = new URL(anchor.href, window.location.href);
        } catch (e) {
            return null;
        }

        if (url.origin !== window.location.origin) return null;
        if (url.pathname !== context + "/item") return null;
        if (!url.searchParams.has("id")) return null;

        url.hash = "";
        return url.href;
    }

    function prefetch(anchor) {
        var href = eligible(anchor);
        if (!href || prefetched.has(href) ||
            prefetched.size >= maximum) return;

        prefetched.add(href);

        var link = document.createElement("link");
        link.rel = "prefetch";
        link.href = href;
        document.head.appendChild(link);
    }

    document.addEventListener("pointerover", function (event) {
        if (event.pointerType === "touch") return;

        var anchor = event.target.closest("a");
        if (!anchor || !eligible(anchor)) return;

        var timer = window.setTimeout(function () {
            prefetch(anchor);
            pending.delete(anchor);
        }, 120);

        pending.set(anchor, timer);
    }, { passive: true });

    document.addEventListener("pointerout", function (event) {
        var anchor = event.target.closest("a");
        if (!anchor || anchor.contains(event.relatedTarget)) return;

        var timer = pending.get(anchor);
        if (timer) {
            window.clearTimeout(timer);
            pending.delete(anchor);
        }
    }, { passive: true });

    document.addEventListener("focusin", function (event) {
        var anchor = event.target.closest("a");
        if (anchor) prefetch(anchor);
    });

    document.addEventListener("pointerdown", function (event) {
        if (event.pointerType === "touch" || event.pointerType === "pen") {
            var anchor = event.target.closest("a");
            if (anchor) prefetch(anchor);
        }
    }, { passive: true });
})();
</script>








<!-- cf-button-navigation-spinner-v2 -->
<script>
(function () {
    "use strict";

    var activeElement = null;
    var fallbackTimer = null;

    function show(element) {
        if (!element || activeElement === element) return;

        restore();

        activeElement = element;
        element.classList.add("cf-nav-click-loading");
        element.setAttribute("aria-busy", "true");

        var spinner = document.createElement("span");
        spinner.className = "cf-nav-click-spinner";
        spinner.setAttribute("aria-hidden", "true");
        element.appendChild(spinner);

        fallbackTimer = window.setTimeout(restore, 30000);
    }

    function restore() {
        if (activeElement) {
            activeElement.classList.remove("cf-nav-click-loading");
            activeElement.setAttribute("aria-busy", "false");

            var spinner = activeElement.querySelector(
                ":scope > .cf-nav-click-spinner"
            );

            if (spinner) spinner.remove();
            activeElement = null;
        }

        if (fallbackTimer) {
            window.clearTimeout(fallbackTimer);
            fallbackTimer = null;
        }
    }

    function validDestination(anchor) {
        if (!anchor || anchor.hasAttribute("download")) return false;
        if (anchor.target && anchor.target !== "_self") return false;
        if (anchor.closest("[data-no-nav-spinner]")) return false;

        try {
            var url = new URL(anchor.href, window.location.href);

            if (url.origin !== window.location.origin) return false;
            if (!/^https?:$/.test(url.protocol)) return false;

            if (url.pathname === window.location.pathname &&
                url.search === window.location.search &&
                url.hash !== window.location.hash) return false;

            return url.href !== window.location.href;
        } catch (error) {
            return false;
        }
    }

    // Ordinary internal navigation links, including View Details.
    document.addEventListener("click", function (event) {
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.ctrlKey || event.metaKey ||
            event.shiftKey || event.altKey) return;

        var target = event.target;
        if (!target || !target.closest) return;

        var anchor = target.closest("a[href]");
        if (!validDestination(anchor)) return;

        show(anchor);
    }, true);

    // Buttons that submit forms and cause normal page navigation.
    document.addEventListener("submit", function (event) {
        if (event.defaultPrevented) return;

        var form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.target && form.target !== "_self") return;
        if (form.hasAttribute("data-no-nav-spinner")) return;

        var submitter = event.submitter;

        if (!submitter || submitter.disabled ||
            submitter.tagName !== "BUTTON") return;

        show(submitter);
    });

    window.addEventListener("pageshow", restore);
    window.addEventListener("pagehide", function () {
        if (fallbackTimer) {
            window.clearTimeout(fallbackTimer);
            fallbackTimer = null;
        }
    });

})();
</script>
