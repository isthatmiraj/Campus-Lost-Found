<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.campus.lostfound.model.Item,com.campus.lostfound.model.User,com.campus.lostfound.util.WebUtil" %><%@ include file="partials.jspf" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>CampusFind · Lost & Found</title><link rel="stylesheet" href="<%=ctx%>/css/style.css"></head><body><%@ include file="nav.jspf" %>
<main class="container"><section class="hero"><div><p class="eyebrow">LOST SOMETHING? FOUND SOMETHING?</p><h1>Good things find<br><span>their way back.</span></h1><p class="hero-copy">A shared campus space to report missing belongings and help return found items to their owners.</p><div class="hero-actions"><a class="btn" href="<%=ctx%>/report-item">＋ Report an item</a><a class="btn btn-light" href="#listings">Browse listings</a></div></div><div class="hero-art"><div class="art-circle"></div><div class="floating-card card-one">🎒 <span>Backpack</span><b>FOUND</b></div><div class="floating-card card-two">🔑 <span>Keys</span><b>LOST</b></div><div class="art-note">Small things matter.<br><strong>Let's reunite them.</strong></div></div></section>
<% if (request.getParameter("submitted") != null) { %><div class="success">Your report has been submitted and is awaiting admin approval before it appears publicly.</div><% } if (session.getAttribute("flashError") != null) { %><div class="alert"><%=WebUtil.h((String)session.getAttribute("flashError"))%></div><% session.removeAttribute("flashError"); } %>
<% java.util.List<Item> approvedStats = com.campus.lostfound.util.DataStore.get().allItems().stream().filter(i -> "APPROVED".equals(i.getApprovalStatus())).collect(java.util.stream.Collectors.toList()); %><section class="admin-stats" aria-label="Campus statistics"><div class="admin-stat"><span>Total listings</span><strong><%=approvedStats.size()%></strong></div><div class="admin-stat"><span>Found items</span><strong><%=approvedStats.stream().filter(i -> "FOUND".equals(i.getType())).count()%></strong></div><div class="admin-stat"><span>Lost items</span><strong><%=approvedStats.stream().filter(i -> "LOST".equals(i.getType())).count()%></strong></div><div class="admin-stat"><span>Returned</span><strong><%=approvedStats.stream().filter(i -> "RETURNED".equals(i.getStatus())).count()%></strong></div></section><section id="listings" class="section-head"><div><p class="eyebrow">CAMPUS BOARD</p><h2>Recent listings</h2><p class="muted">Search for a match or browse the latest reports.</p></div><span class="count"><%=((List<Item>)request.getAttribute("items")).size()%> listings</span></section>
<form class="searchbar advanced-search" method="get" action="<%=ctx%>/items"><input name="q" value="<%=WebUtil.h((String)request.getAttribute("q"))%>" placeholder="Search title, description, category…"><select name="type"><option value="ALL" <%= "ALL".equals(request.getAttribute("type")) ? "selected" : "" %>>All types</option><option value="LOST" <%= "LOST".equals(request.getAttribute("type")) ? "selected" : "" %>>Lost</option><option value="FOUND" <%= "FOUND".equals(request.getAttribute("type")) ? "selected" : "" %>>Found</option></select><select name="category"><option value="">All categories</option><%for(String c: new String[]{"Electronics","Accessories","Books & stationery","Clothing","Keys","Cards & IDs","Bags","Other"}){%><option value="<%=c%>" <%=c.equals(request.getAttribute("category"))?"selected":""%>><%=c%></option><%}%></select><input name="location" value="<%=WebUtil.h((String)request.getAttribute("location"))%>" placeholder="Location"><select name="status"><option value="ALL">Any status</option><%for(String st:new String[]{"OPEN","CLAIM_PENDING","RETURN_PENDING","RETURNED"}){%><option value="<%=st%>" <%=st.equals(request.getAttribute("status"))?"selected":""%>><%=st.replace('_',' ')%></option><%}%></select><label class="date-filter">From<input type="date" name="from" value="<%=WebUtil.h((String)request.getAttribute("from"))%>"></label><label class="date-filter">To<input type="date" name="to" value="<%=WebUtil.h((String)request.getAttribute("to"))%>"></label><button class="btn" type="submit">Apply filters</button><a class="btn btn-light" href="<%=ctx%>/items">Clear</a></form>
<div class="grid">
<% List<Item> items = (List<Item>)request.getAttribute("items"); Map<String,User> reporters = (Map<String,User>)request.getAttribute("reporters"); for (Item item : items) { User reporter = reporters == null ? null : reporters.get(item.getReporterId()); %><article class="item-card"><div class="item-top"><span class="type-pill <%=item.getType().equals("FOUND")?"found":"lost"%>"><%=WebUtil.h(item.getType())%></span><span class="status"><%=WebUtil.h(item.getStatus().replace('_',' '))%></span></div><% if (item.getPhotoName() != null && !item.getPhotoName().isBlank()) { %><img class="item-photo" src="<%=WebUtil.h(com.campus.lostfound.util.PhotoUtil.imageSrc(item.getPhotoName(),ctx))%>" alt="Photo of <%=WebUtil.h(item.getTitle())%>" loading="lazy"><% } else { %><div class="item-icon"><%= "Electronics".equalsIgnoreCase(item.getCategory()) ? "🎧" : "FOUND".equals(item.getType()) ? "🧳" : "🔎" %></div><% } %><h3><a href="<%=ctx%>/item?id=<%=java.net.URLEncoder.encode(item.getId(),java.nio.charset.StandardCharsets.UTF_8)%>"><%=WebUtil.h(item.getTitle())%></a></h3><p class="muted"><%=WebUtil.h(item.getDescription())%></p><div class="item-meta"><span>⌖ <%=WebUtil.h(item.getLocation())%></span><span>◷ <%=WebUtil.h(item.getDate())%></span></div><div class="item-actions"><a class="btn btn-light btn-small" href="<%=ctx%>/item?id=<%=java.net.URLEncoder.encode(item.getId(),java.nio.charset.StandardCharsets.UTF_8)%>">View details</a></div>
<% if ("FOUND".equals(item.getType())) { %><div class="contact-box"><strong>Contact</strong><span><%=reporter == null ? "Campus user" : WebUtil.h(reporter.getName())%></span><% if (reporter != null) { %><a href="mailto:<%=WebUtil.h(reporter.getEmail())%>"><%=WebUtil.h(reporter.getEmail())%></a><% } %><% if (item.getContactPhone() != null && !item.getContactPhone().isBlank()) { %><a href="tel:<%=WebUtil.h(item.getContactPhone())%>"><%=WebUtil.h(item.getContactPhone())%></a><% } %></div><% } %>
<% if (WebUtil.loggedIn(request) && "FOUND".equals(item.getType()) && "OPEN".equals(item.getStatus()) && !WebUtil.userId(request).equals(item.getReporterId())) { %><details class="claim-box"><summary>Is this yours? Submit a claim</summary><form method="post" action="<%=ctx%>/claim"><input type="hidden" name="itemId" value="<%=WebUtil.h(item.getId())%>"><label>Ownership clue<textarea name="proof" required minlength="5" maxlength="1000" placeholder="Describe a detail that helps verify ownership."></textarea></label><button class="btn btn-small" type="submit">Submit claim</button></form></details><% } else if (!WebUtil.loggedIn(request) && "FOUND".equals(item.getType()) && "OPEN".equals(item.getStatus())) { %><a class="text-link" href="<%=ctx%>/login">Log in to claim →</a><% } %></article><% } if (items.isEmpty()) { %><div class="empty"><div>🔍</div><h3>No matching listings</h3><p>Try a different search or be the first to report an item.</p></div><% } %></div>
<footer class="footer">CampusFind · A student-built lost and found project</footer></main></body></html>
