<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="com.campus.lostfound.util.WebUtil" %><%@ include file="partials.jspf" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Report an item · CampusFind</title><link rel="stylesheet" href="<%=ctx%>/css/style.css"></head><body><%@ include file="nav.jspf" %><main class="narrow panel"><p class="eyebrow">HELP YOUR CAMPUS</p><h1>Report an item</h1><p class="muted">Share enough detail for someone to recognise the item, but keep private identifying details out of the public description.</p>
<% if (request.getAttribute("error") != null) { %><div class="alert"><%=WebUtil.h((String)request.getAttribute("error"))%></div><% } %>
<form method="post" enctype="multipart/form-data" action="<%=ctx%>/report-item"><label>Report type<select name="type" required><option value="LOST">I lost an item</option><option value="FOUND">I found an item</option></select></label><label>Item name<input name="title" required minlength="2" maxlength="120" placeholder="e.g. Black water bottle"></label><label>Category<select name="category" required><option>Accessories</option><option>Electronics</option><option>Books & stationery</option><option>Clothing</option><option>Keys</option><option>Cards & IDs</option><option>Bags</option><option>Other</option></select></label><label>Location<input name="location" required minlength="2" maxlength="150" placeholder="e.g. Library, second floor"></label><label>Date lost/found<input type="date" name="date" required></label><label>Photo (optional)<input type="file" name="photo" accept="image/jpeg,image/png"><small>Upload a clear JPG or PNG image, up to 5 MB. Avoid showing private information in the photo.</small></label><label>Description<textarea name="description" required minlength="3" maxlength="2000" rows="5" placeholder="Colour, general appearance, and other non-sensitive details"></textarea></label><label>Contact phone (optional)<input type="tel" name="contactPhone" maxlength="30" pattern="[+0-9() .-]{7,30}" placeholder="e.g. +91 98765 43210"><small>Shown on this listing so someone can contact you. Your account email is also shown on found-item listings.</small></label><button class="btn" type="submit">Publish report</button><a class="cancel" href="<%=ctx%>/items">Cancel</a></form></main><script>const photoInput=document.querySelector('input[type="file"][name="photo"]');if(photoInput){photoInput.addEventListener('change',()=>{let old=document.getElementById('photo-preview');if(old)old.remove();const f=photoInput.files&&photoInput.files[0];if(!f)return;if(!['image/jpeg','image/png'].includes(f.type)){photoInput.value='';alert('Choose a JPG or PNG image.');return;}if(f.size>5*1024*1024){photoInput.value='';alert('Image must be 5 MB or smaller.');return;}const img=document.createElement('img');img.id='photo-preview';img.alt='Selected item photo preview';img.style.cssText='display:block;max-width:260px;max-height:220px;object-fit:contain;border-radius:12px;margin:12px 0;border:1px solid #e2e8f0';img.src=URL.createObjectURL(f);photoInput.insertAdjacentElement('afterend',img);});}</script></body></html>
